# کپی: copy .env.example .env

# توسعه: DEBUG=True | سرور: DEBUG=False
DEBUG=True
SECRET_KEY=یک-رشته-تصادفی-طولانی-برای-پروداکشن

ALLOWED_HOSTS=localhost,127.0.0.1,ayinyar.ir,www.ayinyar.ir
CSRF_TRUSTED_ORIGINS=https://ayinyar.ir,https://www.ayinyar.ir

DB_NAME=amozeshgah_db
DB_USER=postgres
DB_PASSWORD=1
DB_HOST=localhost
DB_PORT=5432

TIME_ZONE=Asia/Tehran

# مسیر media روی سرور (اختیاری؛ پیش‌فرض: پوشه media پروژه)
# MEDIA_ROOT=/var/www/amozeshgah/media

# فقط برای تست بدون nginx؛ روی سرور واقعی False بگذار
SERVE_MEDIA=True

# --- SEO (Production) ---
SITE_DOMAIN=ayinyar.ir
SITE_URL=https://ayinyar.ir

# از Google Search Console > تنظیمات > مالکیت > برچسب HTML
GOOGLE_SITE_VERIFICATION=

# از Google Analytics > Admin > Data Streams
GOOGLE_ANALYTICS_ID=

# True = همه آزمون‌ها رایگان (پرداخت غیرفعال) | False = حالت عادی پولی
QUIZ_ACCESS_FREE_MODE=True
